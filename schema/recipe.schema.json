{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemaiatlas.com/schema/recipe/v1",
  "title": "ChemAI Recipe Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "title",
    "summary",
    "website",
    "status",
    "official",
    "verification",
    "goal",
    "difficulty",
    "cost",
    "privacy",
    "environments",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "enum": [
        "published",
        "needs-review",
        "deprecated"
      ]
    },
    "official": {
      "type": "boolean"
    },
    "verification": {
      "type": "object"
    },
    "goal": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "intermediate",
        "advanced"
      ]
    },
    "cost": {
      "enum": [
        "free",
        "freemium",
        "paid",
        "mixed"
      ]
    },
    "privacy": {
      "enum": [
        "local",
        "mostly-local",
        "cloud",
        "depends-on-configuration"
      ]
    },
    "estimated_setup_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
